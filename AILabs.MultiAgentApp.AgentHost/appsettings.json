{
  "TokenValidation": {
    "Enabled": false,
    "Audiences": [
    ],
    "TenantId": "(none)"
  },

  "AgentApplicationOptions": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false
  },

  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "ClientId": "{INSERTED BY ORCHESTRATOR}",
        "ClientSecret": "{INSERTED BY ORCHESTRATOR}",
        "AuthorityEndpoint": "{INSERTED BY ORCHESTRATOR}",
        "Scopes": [
          "https://api.botframework.com/.default"
        ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ],

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
